# Copiar a .env.local (ya está en .gitignore) para desarrollo, y configurar
# los mismos valores en Vercel → Settings → Environment Variables para producción.
# NUNCA comitear los valores reales.

# ── Metricool (fuente de datos) ──
# Metricool → avatar → Configuración → pestaña Conexiones / API.
METRICOOL_USER_ID=
METRICOOL_USER_TOKEN=

# ── Acceso al panel (login de Sentido) ──
# Inventa una contraseña y un token largo aleatorio (el token va en la cookie).
PANEL_PASSWORD=
PANEL_TOKEN=

# ── Segundo usuario (opcional) ──
# PANEL_PASSWORD_2=
# PANEL_TOKEN_2=
